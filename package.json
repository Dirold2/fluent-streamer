{
  "name": "fluent-streamer",
  "version": "0.8.3",
  "description": "Fluent FFmpeg wrapper with real-time audio effects, timeout and progress tracking.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "ffmpeg",
    "typescript",
    "fluent",
    "video",
    "audio",
    "streaming"
  ],
  "author": "dirold2",
  "license": "MIT",
  "scripts": {
    "build": "tsc && esbuild \"dist/**/*.js\" --outdir=dist --allow-overwrite --minify --sourcemap && d-build",
    "typecheck": "bun run typecheck:shared && bun run typecheck:node && bun run typecheck:bun && bun run typecheck:deno",
    "typecheck:shared": "tsc -p tsconfig.check.shared.json",
    "typecheck:node": "tsc -p tsconfig.check.node.json",
    "typecheck:bun": "tsc -p tsconfig.check.bun.json",
    "typecheck:deno": "tsc -p tsconfig.check.deno.json",
    "dist": "d-dist",
    "deploy": "npm run build && npm run dist",
    "pub": "d-publish",
    "lint": "oxlint src tests",
    "lint:fix": "oxlint src tests --fix",
    "format": "oxfmt src tests",
    "format:check": "oxfmt src tests --check",
    "test": "vitest run",
    "test:node": "node node_modules/vitest/vitest.mjs run",
    "test:bun": "bun --bun node_modules/vitest/vitest.mjs run --no-file-parallelism --maxWorkers=1 --cache=false",
    "test:deno": "deno run --no-prompt -A node_modules/vitest/vitest.mjs run --no-file-parallelism --maxWorkers=1 --cache=false",
    "test:runtime:node": "bun run test:node tests/RuntimeWorker.test.ts",
    "test:runtime:bun": "bun run test:bun tests/RuntimeWorker.test.ts",
    "test:runtime:deno": "bun run test:deno tests/RuntimeWorker.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "hcacher": "^0.3.0",
    "hemmiter": "^0.1.0",
    "hyperttp": "^0.7.4"
  },
  "optionalDependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15"
  },
  "devDependencies": {
    "@dirold2/dev-tools": "^1.1.3",
    "@types/bun": "^1.4.4",
    "@types/deno": "^2.7.0",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "tslib": "^2.9.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
